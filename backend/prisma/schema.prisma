// StudyFlow Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================= ENUMS =================

enum SubjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ON_TRACK
  AT_RISK
  BEHIND
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SessionType {
  FOCUS
  REVISION
  PRACTICE
  READING
  OTHER
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ResourceType {
  VIDEO
  ARTICLE
  WEBSITE
  DOCUMENTATION
  COURSE
  PDF
  BOOK
  TUTORIAL
  PRACTICE
  OTHER
}

// ================= MODELS =================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subjects      Subject[]
  goals         Goal[]
  tasks         Task[]
  studySessions StudySession[]
  resources     Resource[]

  @@map("users")
}

model Subject {
  id          String        @id @default(uuid())
  userId      String
  name        String
  description String?
  color       String?       @default("#06B6D4")
  icon        String?
  targetDate  String?
  status      SubjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  goals         Goal[]
  tasks         Task[]
  studySessions StudySession[]
  resources     Resource[]

  @@unique([userId, name])
  @@index([userId])
  @@map("subjects")
}

model Goal {
  id          String     @id @default(uuid())
  userId      String
  subjectId   String
  title       String
  description String?
  targetDate  String?
  status      GoalStatus @default(ACTIVE)
  progress    Int        @default(0) // Range 0 - 100
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject       Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  tasks         Task[]
  studySessions StudySession[]
  resources     Resource[]

  @@index([userId])
  @@index([subjectId])
  @@index([status])
  @@index([targetDate])
  @@map("goals")
}

model Task {
  id          String       @id @default(uuid())
  userId      String
  subjectId   String
  goalId      String?
  title       String
  description String?
  dueDate     String?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject       Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  goal          Goal?          @relation(fields: [goalId], references: [id], onDelete: SetNull)
  studySessions StudySession[]
  resources     Resource[]

  @@index([userId])
  @@index([subjectId])
  @@index([goalId])
  @@index([status])
  @@index([dueDate])
  @@map("tasks")
}

model StudySession {
  id               String        @id @default(uuid())
  userId           String
  subjectId        String
  goalId           String?
  taskId           String?
  sessionType      SessionType   @default(FOCUS)
  plannedDuration  Int           // Duration in minutes
  actualDuration   Int           // Duration in minutes
  startedAt        DateTime      @default(now())
  endedAt          DateTime?
  sessionIntent    String?
  completionResult String?
  reflection       String?
  qualityRating    Int?          // 1 to 5
  status           SessionStatus @default(COMPLETED)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  goal    Goal?   @relation(fields: [goalId], references: [id], onDelete: SetNull)
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([subjectId])
  @@index([goalId])
  @@index([taskId])
  @@index([status])
  @@index([startedAt])
  @@map("study_sessions")
}

model Resource {
  id                String       @id @default(uuid())
  userId            String
  subjectId         String
  goalId            String?
  taskId            String?
  title             String
  description       String?
  url               String
  type              ResourceType @default(WEBSITE)
  source            String?
  isSaved           Boolean      @default(true)
  isFavorite        Boolean      @default(false)
  isAISuggested     Boolean      @default(false)
  aiRelevanceReason String?
  lastOpenedAt      DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  goal    Goal?   @relation(fields: [goalId], references: [id], onDelete: SetNull)
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([subjectId])
  @@index([goalId])
  @@index([taskId])
  @@index([type])
  @@index([isSaved])
  @@index([isFavorite])
  @@map("resources")
}
